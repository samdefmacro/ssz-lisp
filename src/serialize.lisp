(in-package #:ssz)

(named-readtables:in-readtable coalton:coalton)

(coalton-toplevel
  ;;; Serialization functions for basic SSZ types
  ;;; All integers are serialized in little-endian format

  ;; Serialize U8 (1 byte)
  (declare serialize-u8 (U8 -> Bytes))
  (define (serialize-u8 val)
    "Serialize a U8 to a single byte"
    (lisp Bytes (val)
      (cl:let ((result (cl:make-array 1 :fill-pointer 1 :adjustable cl:t)))
        (cl:setf (cl:aref result 0) val)
        result)))

  ;; Serialize U16 (2 bytes, little-endian)
  (declare serialize-u16 (U16 -> Bytes))
  (define (serialize-u16 val)
    "Serialize a U16 to 2 bytes (little-endian)"
    (lisp Bytes (val)
      (cl:let ((result (cl:make-array 2 :fill-pointer 2 :adjustable cl:t)))
        (cl:setf (cl:aref result 0) (cl:ldb (cl:byte 8 0) val))
        (cl:setf (cl:aref result 1) (cl:ldb (cl:byte 8 8) val))
        result)))

  ;; Serialize U32 (4 bytes, little-endian)
  (declare serialize-u32 (U32 -> Bytes))
  (define (serialize-u32 val)
    "Serialize a U32 to 4 bytes (little-endian)"
    (lisp Bytes (val)
      (cl:let ((result (cl:make-array 4 :fill-pointer 4 :adjustable cl:t)))
        (cl:setf (cl:aref result 0) (cl:ldb (cl:byte 8 0) val))
        (cl:setf (cl:aref result 1) (cl:ldb (cl:byte 8 8) val))
        (cl:setf (cl:aref result 2) (cl:ldb (cl:byte 8 16) val))
        (cl:setf (cl:aref result 3) (cl:ldb (cl:byte 8 24) val))
        result)))

  ;; Serialize U64 (8 bytes, little-endian)
  (declare serialize-u64 (U64 -> Bytes))
  (define (serialize-u64 val)
    "Serialize a U64 to 8 bytes (little-endian)"
    (lisp Bytes (val)
      (cl:let ((result (cl:make-array 8 :fill-pointer 8 :adjustable cl:t)))
        (cl:setf (cl:aref result 0) (cl:ldb (cl:byte 8 0) val))
        (cl:setf (cl:aref result 1) (cl:ldb (cl:byte 8 8) val))
        (cl:setf (cl:aref result 2) (cl:ldb (cl:byte 8 16) val))
        (cl:setf (cl:aref result 3) (cl:ldb (cl:byte 8 24) val))
        (cl:setf (cl:aref result 4) (cl:ldb (cl:byte 8 32) val))
        (cl:setf (cl:aref result 5) (cl:ldb (cl:byte 8 40) val))
        (cl:setf (cl:aref result 6) (cl:ldb (cl:byte 8 48) val))
        (cl:setf (cl:aref result 7) (cl:ldb (cl:byte 8 56) val))
        result)))

  ;; Serialize U128 (16 bytes, little-endian)
  (declare serialize-u128 (U128 -> Bytes))
  (define (serialize-u128 val)
    "Serialize a U128 to 16 bytes (little-endian)"
    (let ((w0 (u128-word 0 val))
          (w1 (u128-word 1 val)))
      (lisp Bytes (w0 w1)
        (cl:let ((result (cl:make-array 16 :fill-pointer 16 :adjustable cl:t)))
          ;; Word 0 (bytes 0-7)
          (cl:setf (cl:aref result 0) (cl:ldb (cl:byte 8 0) w0))
          (cl:setf (cl:aref result 1) (cl:ldb (cl:byte 8 8) w0))
          (cl:setf (cl:aref result 2) (cl:ldb (cl:byte 8 16) w0))
          (cl:setf (cl:aref result 3) (cl:ldb (cl:byte 8 24) w0))
          (cl:setf (cl:aref result 4) (cl:ldb (cl:byte 8 32) w0))
          (cl:setf (cl:aref result 5) (cl:ldb (cl:byte 8 40) w0))
          (cl:setf (cl:aref result 6) (cl:ldb (cl:byte 8 48) w0))
          (cl:setf (cl:aref result 7) (cl:ldb (cl:byte 8 56) w0))
          ;; Word 1 (bytes 8-15)
          (cl:setf (cl:aref result 8) (cl:ldb (cl:byte 8 0) w1))
          (cl:setf (cl:aref result 9) (cl:ldb (cl:byte 8 8) w1))
          (cl:setf (cl:aref result 10) (cl:ldb (cl:byte 8 16) w1))
          (cl:setf (cl:aref result 11) (cl:ldb (cl:byte 8 24) w1))
          (cl:setf (cl:aref result 12) (cl:ldb (cl:byte 8 32) w1))
          (cl:setf (cl:aref result 13) (cl:ldb (cl:byte 8 40) w1))
          (cl:setf (cl:aref result 14) (cl:ldb (cl:byte 8 48) w1))
          (cl:setf (cl:aref result 15) (cl:ldb (cl:byte 8 56) w1))
          result))))

  ;; Serialize U256 (32 bytes, little-endian)
  (declare serialize-u256 (U256 -> Bytes))
  (define (serialize-u256 val)
    "Serialize a U256 to 32 bytes (little-endian)"
    (let ((w0 (u256-word 0 val))
          (w1 (u256-word 1 val))
          (w2 (u256-word 2 val))
          (w3 (u256-word 3 val)))
      (lisp Bytes (w0 w1 w2 w3)
        (cl:let ((result (cl:make-array 32 :fill-pointer 32 :adjustable cl:t)))
          ;; Word 0 (bytes 0-7)
          (cl:setf (cl:aref result 0) (cl:ldb (cl:byte 8 0) w0))
          (cl:setf (cl:aref result 1) (cl:ldb (cl:byte 8 8) w0))
          (cl:setf (cl:aref result 2) (cl:ldb (cl:byte 8 16) w0))
          (cl:setf (cl:aref result 3) (cl:ldb (cl:byte 8 24) w0))
          (cl:setf (cl:aref result 4) (cl:ldb (cl:byte 8 32) w0))
          (cl:setf (cl:aref result 5) (cl:ldb (cl:byte 8 40) w0))
          (cl:setf (cl:aref result 6) (cl:ldb (cl:byte 8 48) w0))
          (cl:setf (cl:aref result 7) (cl:ldb (cl:byte 8 56) w0))
          ;; Word 1 (bytes 8-15)
          (cl:setf (cl:aref result 8) (cl:ldb (cl:byte 8 0) w1))
          (cl:setf (cl:aref result 9) (cl:ldb (cl:byte 8 8) w1))
          (cl:setf (cl:aref result 10) (cl:ldb (cl:byte 8 16) w1))
          (cl:setf (cl:aref result 11) (cl:ldb (cl:byte 8 24) w1))
          (cl:setf (cl:aref result 12) (cl:ldb (cl:byte 8 32) w1))
          (cl:setf (cl:aref result 13) (cl:ldb (cl:byte 8 40) w1))
          (cl:setf (cl:aref result 14) (cl:ldb (cl:byte 8 48) w1))
          (cl:setf (cl:aref result 15) (cl:ldb (cl:byte 8 56) w1))
          ;; Word 2 (bytes 16-23)
          (cl:setf (cl:aref result 16) (cl:ldb (cl:byte 8 0) w2))
          (cl:setf (cl:aref result 17) (cl:ldb (cl:byte 8 8) w2))
          (cl:setf (cl:aref result 18) (cl:ldb (cl:byte 8 16) w2))
          (cl:setf (cl:aref result 19) (cl:ldb (cl:byte 8 24) w2))
          (cl:setf (cl:aref result 20) (cl:ldb (cl:byte 8 32) w2))
          (cl:setf (cl:aref result 21) (cl:ldb (cl:byte 8 40) w2))
          (cl:setf (cl:aref result 22) (cl:ldb (cl:byte 8 48) w2))
          (cl:setf (cl:aref result 23) (cl:ldb (cl:byte 8 56) w2))
          ;; Word 3 (bytes 24-31)
          (cl:setf (cl:aref result 24) (cl:ldb (cl:byte 8 0) w3))
          (cl:setf (cl:aref result 25) (cl:ldb (cl:byte 8 8) w3))
          (cl:setf (cl:aref result 26) (cl:ldb (cl:byte 8 16) w3))
          (cl:setf (cl:aref result 27) (cl:ldb (cl:byte 8 24) w3))
          (cl:setf (cl:aref result 28) (cl:ldb (cl:byte 8 32) w3))
          (cl:setf (cl:aref result 29) (cl:ldb (cl:byte 8 40) w3))
          (cl:setf (cl:aref result 30) (cl:ldb (cl:byte 8 48) w3))
          (cl:setf (cl:aref result 31) (cl:ldb (cl:byte 8 56) w3))
          result))))

  ;; Serialize Boolean (1 byte: 0x00 for False, 0x01 for True)
  (declare serialize-bool (Boolean -> Bytes))
  (define (serialize-bool val)
    "Serialize a Boolean to a single byte"
    (lisp Bytes (val)
      (cl:let ((result (cl:make-array 1 :fill-pointer 1 :adjustable cl:t)))
        (cl:setf (cl:aref result 0) (cl:if val 1 0))
        result)))

  ;; Serialize offset (4 bytes, little-endian U32)
  (declare serialize-offset (U32 -> Bytes))
  (define serialize-offset serialize-u32))
